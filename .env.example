# ---------------------------------------------------------------
# SchemaSync AI – environment variables
# Copy to .env.local for local dev, or add in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------

# Optional: protect the whole app with a username/password prompt (recommended on Vercel).
APP_USER=admin
APP_PASSWORD=

# AI provider: anthropic | openai | azure | ollama | none
AI_PROVIDER=none

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama (self-hosted only – Vercel cannot reach a local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
